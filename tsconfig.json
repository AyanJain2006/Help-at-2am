{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
, "app/security/components/RequestList.jsx", "app/security/components/PriorityBadge.jsx", "app/security/components/StatusBadge.jsx", "app/security/components/StatCard.jsx", "app/security/components/Sidebar.jsx", "app/security/components/RequestDetails.jsx", "app/security/page.jsx", "app/context/EmergencyContext.jsx", "app/student/page.jsx", "app/page.jsx", "app/layout.jsx", "next.config.mjs"  ],
  "exclude": ["node_modules"]
}
